# Copy this file to .env for local development.
# Do not commit .env or paste real connection strings into chat.

WDL_ENV=development

# FastAPI runtime: use the Neon POOLED connection string here.
# Replace USER, PASSWORD, HOST, and DB with your own values.
WDL_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require

# Alembic migrations: use the Neon DIRECT connection string here.
WDL_MIGRATION_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require

# Include the local Vite origin during development.
WDL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ouyangxinwei.github.io
